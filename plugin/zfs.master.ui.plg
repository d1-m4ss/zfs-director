            if(!is_array($j)||!is_string($j['"'"'state'"'"']??null)||in_array($j['"'"'state'"'"'],['"'"'queued'"'"','"'"'running'"'"'],true))$requireRecovery('"'"'Pending or unverified jobs require inspection; worker stays stopped'"'"');
